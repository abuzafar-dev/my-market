SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://my_market_user:change-me@localhost:5433/my_market_db
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Dev only (config.settings.dev). Your machine's LAN IP, so the app is
# reachable from a phone on the same Wi-Fi — find it with `hostname -I`,
# it changes per network/developer. See QOLLANMA.md.
DEV_LAN_HOST=10.183.211.58

# Only read by docker-compose.yml (the db service + backend's DATABASE_URL
# override) — the DATABASE_URL above is for the host-based dev workflow in
# QOLLANMA.md and ignores these.
POSTGRES_DB=my_market_db
POSTGRES_USER=my_market_user
POSTGRES_PASSWORD=change-me

# Production only (DJANGO_SETTINGS_MODULE=config.settings.prod). Leave
# unset (defaults to true) behind a TLS-terminating proxy/load balancer;
# set to false only for a bare `docker compose up` smoke test with no TLS
# in front.
# SECURE_SSL_REDIRECT=true
