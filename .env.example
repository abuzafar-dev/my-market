# Local development (host-based, see QOLLANMA.md) — copy to `.env`.
# For a real server use deploy/env.production.example instead.
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://my_market_user:change-me@localhost:5433/my_market_db
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Dev only (config.settings.dev). Your machine's LAN IP, so the app is
# reachable from a phone on the same Wi-Fi — `scripts/dev.sh` fills this in.
DEV_LAN_HOST=192.168.0.10

# Only read by docker-compose.yml (the db service + backend's DATABASE_URL
# override) — the DATABASE_URL above is for the host-based dev workflow and
# ignores these.
POSTGRES_DB=my_market_db
POSTGRES_USER=my_market_user
POSTGRES_PASSWORD=change-me

# Docker only: create the demo shop (+998900000001 / demo12345, 10 products) on
# start. Leave false on a real server. run.sh sets it to True for a demo.
# SEED_DEMO=False

# Docker only: published address of the site (nginx).
# WEB_BIND=127.0.0.1
# WEB_PORT=8080

# Production (config.settings.prod) — leave true behind a TLS proxy; only a bare
# `docker compose up` on plain HTTP needs false (run.sh does that for you).
# SECURE_SSL_REDIRECT=True
