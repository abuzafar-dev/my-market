# Production settings. Copy to the project root as `.env` and fill in every
# value marked CHANGE. Never commit the real .env.

# --- CHANGE: a long random string, e.g. `python3 -c "import secrets; print(secrets.token_urlsafe(50))"`
SECRET_KEY=CHANGE-ME

# --- CHANGE: your domain(s), comma separated, no https://
ALLOWED_HOSTS=shop.example.uz
# --- CHANGE: the same domain WITH https:// (needed for the /admin/ login)
CSRF_TRUSTED_ORIGINS=https://shop.example.uz

# --- CHANGE: database password (any long random string, letters and digits only)
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=my_market_db
POSTGRES_USER=my_market_user

# gunicorn worker processes (about 100 MB of RAM each). 3 is fine for a dedicated
# server; on one shared with other projects use 2.
WEB_CONCURRENCY=2

# Behind Caddy with HTTPS: keep true. Only for a plain-HTTP test without any
# TLS in front, set false.
SECURE_SSL_REDIRECT=True

# TEST ONLY — plain HTTP by IP with no TLS at all (no camera scanner, passwords
# unencrypted). Leave False; see QOLLANMA.md "Domensiz" for the proper way.
ALLOW_INSECURE_HTTP=False

# Never demo data / public passwords on a real server.
SEED_DEMO=False

# The Django admin is a full back door to the data: keep it OFF. To use it for a
# moment set True, run `docker compose up -d`, and switch it back afterwards.
# (Add staff without it: `manage.py add_user`, see QOLLANMA.md.)
ADMIN_ENABLED=False

# Proxies in front of the app (Caddy + nginx = 2). Do not change unless you
# change that setup: it decides which address the rate limits and login
# lockout attribute a request to.
NUM_PROXIES=2

# nginx is published on 127.0.0.1:8080 and Caddy forwards to it.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# --- Only when ANOTHER Docker container (e.g. Caddy) already owns ports 80/443 ---
# (see QOLLANMA.md section 1b). Uncomment both lines and fill in the network name.
# COMPOSE_FILE=docker-compose.yml:docker-compose.shared-proxy.yml
# PROXY_NETWORK=cinevault_default
