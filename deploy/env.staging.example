# STAGING settings for a stack that may share its Docker host with production.
# Copy to the project root as `.env.staging` (chmod 600), fill in every value
# marked CHANGE, and run every compose command through
#     scripts/staging-compose.sh <command>
# which refuses to start unless the isolation lines below are right.
# Never copy production's .env into this file. See docs/STAGING.md §0a.

# --- Isolation from production (do not change these four) -----------------
# Project name: prefixes containers, volumes, the default network and the
# built images (my-market-staging_postgres_data, my-market-staging-backend...).
COMPOSE_PROJECT_NAME=my-market-staging
# The env file the backend / celery / celery-beat containers load. Without it
# they would load production's `.env`.
APP_ENV_FILE=.env.staging
# Host port of staging's nginx (production uses 8080). Caddy forwards here.
WEB_BIND=127.0.0.1
WEB_PORT=8081
# Only with the shared Docker proxy (docker-compose.shared-proxy.yml): the
# name the shared Caddy uses for staging. Must differ from production's
# "my-market". Uncomment the three lines together.
# COMPOSE_FILE=docker-compose.yml:docker-compose.shared-proxy.yml
# PROXY_NETWORK=CHANGE-ME
# PROXY_ALIAS=my-market-staging

# --- CHANGE: new values, never production's ---------------------------------
SECRET_KEY=CHANGE-ME
ALLOWED_HOSTS=staging.shop.example.uz
CSRF_TRUSTED_ORIGINS=https://staging.shop.example.uz
POSTGRES_PASSWORD=CHANGE-ME
# Inside staging's own db container; the names may equal production's.
POSTGRES_DB=my_market_db
POSTGRES_USER=my_market_user

WEB_CONCURRENCY=2
SECURE_SSL_REDIRECT=True
ALLOW_INSECURE_HTTP=False
SEED_DEMO=False
ADMIN_ENABLED=False
NUM_PROXIES=2

# --- WhatsApp: EMPTY until docs/STAGING.md step B -------------------------
# Use Meta's TEST number and a Meta app whose webhook points at the staging
# domain. Never production's app: one Meta app has one webhook URL, and
# pointing it at staging takes production's incoming messages away.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=
